# --- LLM (pick one) -------------------------------------------------------------
# LLM_PROVIDER = anthropic | gemini | openrouter | mock. If unset: MOCK_LLM=1 -> mock,
# else the first provider with a key (anthropic, gemini, openrouter).
LLM_PROVIDER=
MOCK_LLM=1                       # local dev without keys: canned sample playables

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FALLBACKS=0          # disable server-side refusal fallbacks (on by default)
# ANTHROPIC_EFFORT=medium        # low | medium | high

# Gemini on Vertex AI with an API key (x-goog-api-key). With GOOGLE_CLOUD_PROJECT the
# project-scoped endpoint is used; without it, Vertex express mode.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (OpenAI-compatible chat completions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Storage ----------------------------------------------------------------------
# Postgres (Neon, Coolify Postgres...). Unset = in-memory store (local dev only, lost on restart).
DATABASE_URL=
# DATABASE_POOL_MAX=5

# --- Misc ---------------------------------------------------------------------------
# Public origin used in QR codes and share links (else derived from the Host header).
PUBLIC_BASE_URL=
# Salt for hashing client IPs (raw IPs are never stored). Set a random string in production.
IP_HASH_SALT=change-me
RATE_LIMIT_PER_HOUR=10
